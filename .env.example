# All vars are prefixed JOBASSISTANT_ to avoid collision with generic env vars
# (AZURE_OPENAI_ENDPOINT etc.) that other local projects may set globally.

# --- LLM provider selection (azure_openai | claude | gemini) ---
JOBASSISTANT_LLM_PROVIDER=azure_openai

JOBASSISTANT_AZURE_OPENAI_ENDPOINT=
JOBASSISTANT_AZURE_OPENAI_API_KEY=
JOBASSISTANT_AZURE_OPENAI_API_VERSION=
JOBASSISTANT_AZURE_OPENAI_DEPLOYMENT=

JOBASSISTANT_ANTHROPIC_API_KEY=

JOBASSISTANT_GEMINI_API_KEY=
JOBASSISTANT_GEMINI_MODEL=

# --- Search provider selection (azure_bing | google_custom | apify) ---
JOBASSISTANT_SEARCH_PROVIDER=azure_bing

JOBASSISTANT_AZURE_BING_SEARCH_KEY=
JOBASSISTANT_AZURE_BING_SEARCH_ENDPOINT=

JOBASSISTANT_GOOGLE_CUSTOM_SEARCH_API_KEY=
JOBASSISTANT_GOOGLE_CUSTOM_SEARCH_CX=

# Apify (planned fast-follow after Phase 1)
JOBASSISTANT_APIFY_API_TOKEN=
JOBASSISTANT_APIFY_ACTOR_ID=

# --- App ---
JOBASSISTANT_DATABASE_URL=sqlite:///./data/jobassistant.db
JOBASSISTANT_SCHEDULER_HOUR=7
JOBASSISTANT_MATCH_THRESHOLD=85

# --- Observability (optional, phase 2 / cloud) ---
JOBASSISTANT_APPLICATIONINSIGHTS_CONNECTION_STRING=
